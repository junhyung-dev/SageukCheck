# Upstage Studio API Configuration
# Obtain your API key from https://console.upstage.ai/api-keys (starts with up_)
UPSTAGE_API_KEY=up_your_api_key_here

# Upstage Studio Agent ID & Config ID
UPSTAGE_AGENT_ID=agt_BeWFUxUXkK7tzMpxscYduZ
UPSTAGE_CONFIG_ID=1

# Upstage Studio Project ID (sent as the x-project-id header on every request)
# Required when the agent belongs to a Project
UPSTAGE_PROJECT_ID=proj_your_project_id_here
